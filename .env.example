HOST=0.0.0.0
PORT=3210
DATA_DIR=./data
# Optional additional hostnames, comma separated (no scheme or port).
# LAN interface IPs, localhost and 127.0.0.1 are allowed automatically.
ALLOWED_HOSTS=
# Set BOTH for HTTPS on the same port. Use a certificate trusted by LAN clients.
TLS_CERT_FILE=
TLS_KEY_FILE=
# Legacy Graph API configuration (not needed for browser capture; collector disabled).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v26.0
FACEBOOK_REDIRECT_URI=http://localhost:3210/api/facebook/callback
